# Public Supabase Auth configuration (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Volcengine Ark / 方舟 model analysis
ARK_API_KEY=
ARK_MODEL_ID=deepseek-v4-flash-260425
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Vercel persistence: Cloudflare D1 REST API credentials
# Create a token limited to D1 Read + D1 Write for the selected account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Optional: proxy Vercel API routes to an existing full Timeless backend.
# Leave empty when using the remote D1 variables above.
TIMELESS_BACKEND_ORIGIN=

# Protect scheduled collection/report endpoints.
CORTEX_CRON_SECRET=
CORTEX_BACKFILL_SECRET=

# Comma-separated accounts allowed to trigger collection or model-health calls.
# Cost-bearing actions are denied to non-operators by default.
CORTEX_OPERATOR_EMAILS=

# Unsafe for public deployments unless you also add a deployment-wide quota.
CORTEX_ALLOW_PUBLIC_COSTLY_ACTIONS=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
